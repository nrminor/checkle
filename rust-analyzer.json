{
  "cargo": {
    "features": ["default", "simd"],
    "allTargets": true
  },
  "check": {
    "allTargets": true,
    "command": "clippy",
    "features": ["default", "simd"],
    "extraArgs": ["--", "-D", "warnings"],
    "targets": [
      "x86_64-apple-darwin",
      "aarch64-apple-darwin",
      "x86_64-unknown-linux-gnu",
      "aarch64-unknown-linux-gnu",
      "x86_64-pc-windows-msvc",
      "x86_64-pc-windows-gnu"
    ]
  },
  "procMacro": {
    "enable": true
  }
}
